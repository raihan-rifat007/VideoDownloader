# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.8.3@sha256:ef11ed817e6a5385c02cd49fdcc99c23d02426088252a8eace6b6e6a2a511f36 AS uv
FROM denoland/deno:bin-2.8.1@sha256:324e7887040b297299ec097be8dc570f5eca2c808fe3ad9c52c61f9ab588938c AS deno
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04@sha256:5f0d2d827f6436b3cb7468fd8acbdc8c1d41261614e579ae49afe6141da51133

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONPATH=/app \
    HOME=/home/reclip \
    DATA_DIR=/data \
    WHISPER_MODEL_DIR=/models \
    DEEPFILTER_CACHE_DIR=/cache/deepfilter \
    DEEPFILTER_MODEL_DIR=/opt/deepfilter-models/DeepFilterNet3 \
    ASR_MODELS_DIR=/models \
    ASR_DEEPFILTER_CACHE=/cache/deepfilter \
    HF_HOME=/models/huggingface \
    RECLIP_WORKER_IMAGE_ID=reclip-asr-worker-cuda12.6.3-cudnn9-py3.11.13 \
    XDG_CACHE_HOME=/cache

COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=deno /deno /usr/local/bin/deno
ADD --checksum=sha256:49c52edc8947ae1f9bf50d81530beaf3a2c3245aeaf34b6f31ff535cd22284d2 https://raw.githubusercontent.com/Rikorose/DeepFilterNet/978576aa8400552a4ce9730838c635aa30db5e61/models/DeepFilterNet3.zip /tmp/DeepFilterNet3.zip


RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg libsndfile1 passwd tini \
    && rm -rf /var/lib/apt/lists/* \
    && uv python install 3.11.13 \
    && uv venv --python 3.11.13 /opt/venv \
    && mkdir -p /opt/deepfilter-models \
    && python -m zipfile -e /tmp/DeepFilterNet3.zip /opt/deepfilter-models \
    && test -f /opt/deepfilter-models/DeepFilterNet3/config.ini && rm /tmp/DeepFilterNet3.zip

WORKDIR /app
COPY requirements-worker.txt /app/requirements-worker.txt

# DeepFilterNet uses PyTorch CUDA in its own subprocess.  The CUDA 12.6 wheel
# matches the runtime image; Faster-Whisper/CTranslate2 shares cuDNN 9.
RUN uv pip install --python /opt/venv/bin/python \
        --index-url https://download.pytorch.org/whl/cu126 \
        torch==2.7.1 torchaudio==2.7.1 \
    && uv pip install --python /opt/venv/bin/python \
        --requirement /app/requirements-worker.txt

COPY reclip_asr /app/reclip_asr
COPY worker-entrypoint.sh /app/worker-entrypoint.sh
COPY LICENSE THIRD_PARTY_NOTICES.md /app/

RUN /usr/sbin/groupadd --gid 1000 reclip \
    && /usr/sbin/useradd --uid 1000 --gid 1000 --create-home --home-dir /home/reclip reclip \
    && install -d -o 1000 -g 1000 \
        /data /data/jobs \
        /models /models/huggingface \
        /cache /cache/deepfilter \
    && chmod 0755 /app/worker-entrypoint.sh

USER 1000:1000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
    CMD ["python", "-m", "reclip_asr.worker", "--healthcheck"]

ENTRYPOINT ["/usr/bin/tini", "--", "/app/worker-entrypoint.sh"]
CMD ["python", "-m", "reclip_asr.worker"]
