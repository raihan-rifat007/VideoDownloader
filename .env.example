# Leave empty to let ReClip update yt-dlp extractor components on startup.
RECLIP_NO_UPDATE=

# RTX 3060 Ti / 8 GB defaults.
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16

# Browser uploads are streamed to the reclip-data Docker volume.
MAX_UPLOAD_BYTES=21474836480

# The UI marks the ASR worker offline after this many seconds without a heartbeat.
WORKER_STALE_SECONDS=30

# Explicit CPU mode:
# Build the worker first with .\build-worker.ps1, then start it with:
# docker compose -f docker-compose.yml -f docker-compose.cpu.yml up -d --no-build
